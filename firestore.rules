rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'admin@x.com' ||
        request.auth.token.admin == true
      );
    }

    // Products catalog: anyone can read, only admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories and brands
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders: Anyone can create an order, admin can view all, customer can read own
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (request.auth != null && resource.data.customer.email == request.auth.token.email);
      allow update, delete: if isAdmin();
    }

    // Store settings and CMS
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
